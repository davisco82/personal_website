---
import "../styles/global.css";

const {
  title = "DaVisco Entertainment",
  description = "Personal website, projects, devlog and experiments.",
  ogType = "website",
} = Astro.props;

const canonicalUrl = Astro.url;
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  
  <body>
    <div class="min-h-screen">
      <header class="sticky top-0 z-20 border-b border-zinc-800/80 bg-zinc-950/70 backdrop-blur">
        <div class="page-container flex items-center justify-between py-2">
          <a href="/" class="group relative inline-flex h-10 items-center overflow-visible">
            <img
              src="/images/logo_davisco_entertainment.webp"
              alt="DaVisco Entertainment"
              class="h-9 w-auto max-w-none origin-left transition duration-300 group-hover:scale-[1.05] group-hover:drop-shadow-[0_0_10px_rgba(34,211,238,0.3)]"
            />
          </a>

          <nav class="flex flex-wrap items-center gap-2 text-sm font-semibold text-zinc-200 md:text-base">
            <a href="/projects/" class="rounded-lg px-3 py-2 hover:bg-zinc-800/80 hover:text-white hover:shadow-[0_0_0_1px_rgba(72,178,255,0.2)]">Development</a>
            <a href="/stack" class="rounded-lg px-3 py-2 hover:bg-zinc-800/80 hover:text-white hover:shadow-[0_0_0_1px_rgba(72,178,255,0.2)]">Tech Stack</a>
            <a href="/music/" class="rounded-lg px-3 py-2 hover:bg-zinc-800/80 hover:text-white hover:shadow-[0_0_0_1px_rgba(122,92,255,0.25)]">AI Music</a>
            <a href="/posts/" class="rounded-lg px-3 py-2 hover:bg-zinc-800/80 hover:text-white hover:shadow-[0_0_0_1px_rgba(72,178,255,0.2)]">Posts</a>
            <a href="/contact" class="rounded-lg px-3 py-2 hover:bg-zinc-800/80 hover:text-white hover:shadow-[0_0_0_1px_rgba(72,178,255,0.2)]">Contact</a>
          </nav>
        </div>
      </header>

      <main class="page-container py-12">
        <slot />
      </main>
    </div>
  </body>
</html>
