---
import "../styles/global.css";

const {
  title = "DaVisco Entertainment",
  description = "Personal website, projects, devlog and experiments.",
} = Astro.props;
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  
  <body>
    <div class="min-h-screen">
      <header class="border-b border-zinc-800">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
          <a href="/" class="text-lg font-bold text-white">
            DaVisco Entertainment
          </a>

          <nav class="flex gap-5 text-sm text-zinc-400">
            <a href="/projects">Development</a>
            <a href="/stack">Tech Stack</a>
            <a href="/music">AI Music</a>
            <a href="/posts">Posts</a>
            <a href="/contact">Contact</a>
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-6xl px-6 py-12">
        <slot />
      </main>
    </div>
  </body>
</html>
