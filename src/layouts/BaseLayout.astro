---
import "../styles/global.css";

const {
  title = "DaVisco Entertainment",
  description = "Personal website, projects, devlog and experiments.",
  ogType = "website",
  theme = "neutral",
} = Astro.props;

const canonicalUrl = Astro.url;
const pathname = Astro.url.pathname;

const normalizePath = (path) => (path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path);
const currentPath = normalizePath(pathname);
const isActive = (href) => {
  const target = normalizePath(href);
  return currentPath === target || currentPath.startsWith(`${target}/`);
};

const navLinkClass = (href, accent = "cyan") =>
  `relative rounded-lg px-3 py-2 hover:bg-zinc-800/60 hover:text-white ${
    isActive(href)
      ? accent === "violet"
        ? "text-violet-300 after:absolute after:left-3 after:right-3 after:bottom-1 after:h-px after:rounded-full after:bg-violet-300/80"
        : "text-cyan-300 after:absolute after:left-3 after:right-3 after:bottom-1 after:h-px after:rounded-full after:bg-cyan-300/80"
      : accent === "violet"
        ? ""
        : ""
  }`;
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  
  <body class={`theme-${theme}`}>
    <div class="min-h-screen">
      <header class="sticky top-0 z-20 border-b border-zinc-800/80 bg-zinc-950/70 backdrop-blur">
        <div class="page-container flex items-center justify-between py-2">
          <a href="/" class="group relative inline-flex h-10 items-center overflow-visible">
            <img
              src="/images/logo_davisco_entertainment.webp"
              alt="DaVisco Entertainment"
              class="h-9 w-auto max-w-none origin-left transition duration-300 group-hover:scale-[1.05] group-hover:drop-shadow-[0_0_10px_rgba(34,211,238,0.3)]"
            />
          </a>

          <nav class="flex flex-wrap items-center gap-2 text-sm font-semibold text-zinc-200 md:text-base">
            <a href="/projects/" class={navLinkClass("/projects/")}>Development</a>
            <a href="/music/" class={navLinkClass("/music/", "violet")}>Music</a>
            <a href="/posts/" class={navLinkClass("/posts/")}>Posts</a>
            <a href="/stack" class={navLinkClass("/stack")}>Tech Stack</a>
            <a href="/contact" class={navLinkClass("/contact")}>Contact</a>
          </nav>
        </div>
      </header>

      <main class="page-container py-12">
        <slot />
      </main>

      <footer class="border-t border-zinc-800/80">
        <div class="page-container flex flex-wrap items-center justify-between gap-3 py-5 text-sm text-zinc-400">
          <p>© {new Date().getFullYear()} DaVisco Entertainment</p>
          <div class="flex flex-wrap gap-3">
            <a href="https://www.youtube.com/@DaViscoBackgroundLab" target="_blank" rel="noreferrer" class="hover:text-cyan-300">YouTube</a>
            <a href="https://www.linkedin.com/in/david-volf-6a2b79120" target="_blank" rel="noreferrer" class="hover:text-cyan-300">LinkedIn</a>
            <a href="/contact" class="hover:text-cyan-300">Contact</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
