---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const downloads = (await getCollection("downloads")).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = await getCollection("projects");
const latestPosts = posts.slice(0, 3);
const toolsInProgress = downloads.filter((item) => item.data.kind === "tool").slice(0, 4);
const projectsInProgress = projects.slice(0, 4);
---

<BaseLayout
  title="DaVisco Entertainment"
  description="DaVisco Entertainment combines active software development with AI-driven music production."
>
  <section class="home-hero grid gap-8 pt-6 pb-10 md:grid-cols-[1.3fr_0.7fr] md:items-start">
    <div class="fade-up">
      <p class="mb-4 text-sm font-medium uppercase tracking-[0.3em] text-cyan-400">
        Development + AI Music
      </p>

      <h1 class="max-w-4xl text-5xl font-bold tracking-tight text-white md:text-7xl">
        Build. Play. Ship. Soundtrack.
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-zinc-400">
        I build apps and production tools, while also releasing creator-focused
        background music packs and AI music experiments under one creative
        system.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="/projects/"
          class="btn-primary-brand rounded-xl px-4 py-2 font-semibold text-zinc-950 hover:text-zinc-950"
        >
          Explore Development
        </a>
        <a
          href="/music/"
          class="rounded-xl border border-zinc-700 px-4 py-2 font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white"
        >
          Explore AI Music
        </a>
      </div>
    </div>

    <aside class="glass-card energy-card fade-up rounded-2xl p-6 [animation-delay:120ms]">
      <p class="text-xs uppercase tracking-[0.25em] text-cyan-400">About</p>
      <h2 class="mt-2 text-2xl font-semibold text-white">About the Creator</h2>
      <p class="mt-3 text-zinc-400">
        I build both sides of this system: practical development tools and
        AI-assisted music workflows for creators.
      </p>
      <a
        href="/contact"
        class="mt-5 inline-block text-sm font-semibold text-cyan-300 hover:text-cyan-200"
      >
        More in Contact
      </a>
    </aside>
  </section>

  <section class="pb-8 fade-up [animation-delay:160ms]">
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.3em] text-cyan-400">
      What&apos;s New
    </p>

    <div class="glass-card accent-dev rounded-2xl p-4 md:p-5">
      <div class="grid gap-3 md:grid-cols-3">
        {latestPosts.map((post) => (
          <article class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-4">
            <p class="text-[11px] uppercase tracking-[0.2em] text-cyan-300">
              {post.data.pubDate.toLocaleDateString("cs-CZ")}
            </p>
            <h2 class="mt-2 line-clamp-2 text-lg font-semibold leading-6 text-white">{post.data.title}</h2>
            <p class="mt-2 line-clamp-3 text-sm text-zinc-400">{post.data.description}</p>
            <a
              href={`/posts/${post.id}/`}
              class="mt-3 inline-block text-sm font-semibold text-cyan-300 hover:text-cyan-200"
            >
              Read post
            </a>
          </article>
        ))}
      </div>
      <a href="/posts/" class="btn-primary-brand mt-4 inline-block rounded-xl px-4 py-2 text-sm font-semibold text-zinc-950 hover:text-zinc-950">
        Zobrazit více
      </a>
    </div>
  </section>

  <section class="pb-8 fade-up [animation-delay:190ms]">
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.3em] text-cyan-400">
      DaVisco Music
    </p>
    <article class="feature-surface energy-card accent-music rounded-2xl border p-7">
      <h2 class="text-3xl font-bold text-white">AI music hub for creators</h2>
      <p class="mt-3 max-w-3xl text-zinc-300">
        Music Lab updates, background packs and release previews in one clean flow.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/music/" class="rounded-xl border border-violet-300/40 px-4 py-2 text-sm font-semibold text-violet-100 hover:border-violet-200 hover:text-white">
          Open Music Hub
        </a>
        <a href="/downloads#music-packs" class="rounded-xl border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white">
          Background Packs
        </a>
      </div>
    </article>
  </section>

  <section class="pb-8 fade-up [animation-delay:220ms]">
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.3em] text-cyan-400">
      Tools & Apps
    </p>
    <div class="grid gap-6 md:grid-cols-2">
      <article class="glass-card energy-card accent-dev rounded-2xl p-7">
        <h2 class="text-3xl font-bold text-white">Games & Apps in Progress</h2>
        <ul class="mt-5 space-y-4">
          {projectsInProgress.map((project) => (
            <li class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-4">
              <p class="text-sm text-zinc-500">{project.data.status}</p>
              <h3 class="mt-1 text-lg font-semibold text-white">{project.data.title}</h3>
              <p class="mt-2 text-sm text-zinc-400">{project.data.description}</p>
            </li>
          ))}
        </ul>
        <a href="/projects/" class="mt-5 inline-block text-sm font-semibold text-cyan-300 hover:text-cyan-200">
          Open all projects
        </a>
      </article>

      <article class="glass-card energy-card accent-dev rounded-2xl p-7">
        <h2 class="text-3xl font-bold text-white">Tools in Development</h2>
        <ul class="mt-5 space-y-4">
          {toolsInProgress.map((tool) => (
            <li class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-4">
              <h3 class="text-lg font-semibold text-white">{tool.data.title}</h3>
              <p class="mt-2 text-sm text-zinc-400">{tool.data.description}</p>
              <p class="mt-2 text-xs uppercase tracking-[0.2em] text-zinc-500">Version {tool.data.version ?? "TBD"}</p>
            </li>
          ))}
        </ul>
        <a href="/downloads" class="mt-5 inline-block text-sm font-semibold text-cyan-300 hover:text-cyan-200">
          Open tools page
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
