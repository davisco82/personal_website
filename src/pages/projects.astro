---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<BaseLayout
  title="Development | DaVisco Entertainment"
  description="Active software projects, game systems, and production experiments by DaVisco Entertainment."
>
  <section>
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.3em] text-cyan-400">
      Projects
    </p>

    <h1 class="text-4xl font-bold text-white md:text-6xl">
      Apps, games and production systems.
    </h1>

    <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-400">
      A collection of production projects, experiments and long-term systems
      I am building.
    </p>
  </section>

  <section class="mt-12 grid gap-6 md:grid-cols-2">
    {projects.map((project) => (
      <ProjectCard
        slug={project.id}
        title={project.data.title}
        description={project.data.description}
        status={project.data.status}
        stack={project.data.stack}
        links={project.data.links}
      />
    ))}
  </section>
</BaseLayout>
