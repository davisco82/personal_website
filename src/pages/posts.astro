---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

const publishedPosts = posts
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );

const formatDate = (date: Date) =>
  date.toLocaleDateString("cs-CZ", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const getReadingTime = (content: string) => {
  const words = content.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
};
---

<BaseLayout
  title="Posts | DaVisco Entertainment"
  description="Development logs, release notes, and production updates from DaVisco Entertainment."
>
  <section>
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.3em] text-cyan-400">
      Posts
    </p>
    <h1 class="text-4xl font-bold text-white md:text-6xl">
      Development Notes and Release Logs
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-zinc-400">
      Build updates, architecture decisions, and production lessons from
      development and AI music workflows.
    </p>
  </section>

  <section class="mt-12 grid gap-5">
    {publishedPosts.map((post) => (
      <article class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6">
        <p class="text-sm text-zinc-500">
          {formatDate(post.data.pubDate)} • {getReadingTime(post.body)} min read
        </p>
        <h2 class="mt-2 text-2xl font-semibold text-white">
          <a href={`/posts/${post.id}`} class="hover:text-cyan-300">
            {post.data.title}
          </a>
        </h2>
        <p class="mt-3 text-zinc-400">{post.data.description}</p>
        {post.data.tags && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li class="rounded-full border border-zinc-700 px-3 py-1 text-xs text-zinc-300">
                {tag}
              </li>
            ))}
          </ul>
        )}
      </article>
    ))}
  </section>
</BaseLayout>
