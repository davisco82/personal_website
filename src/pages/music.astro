---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const releases = (await getCollection("musicReleases")).sort(
  (a, b) =>
    (b.data.releaseDate?.getTime() ?? 0) -
    (a.data.releaseDate?.getTime() ?? 0)
);
const mixes = releases.filter((item) => item.data.type === "mix");
const tracks = releases.filter((item) => item.data.type === "track");
---

<BaseLayout
  title="AI Music | DaVisco Entertainment"
  description="DaVisco Music hub with AI music lab workflows, creator packs, mixes, and standalone tracks."
>
  <section>
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.3em] text-cyan-400">
      AI Music
    </p>

    <h1 class="text-4xl font-bold text-white md:text-6xl">
      DaVisco Music
    </h1>

    <p class="mt-5 max-w-3xl text-lg leading-8 text-zinc-400">
      Central hub for music production with AI: lab workflows, creator-ready
      background packs, and released music split between mixes and standalone
      tracks.
    </p>
    <p class="mt-3 max-w-3xl text-zinc-500">
      Full-track previews are published on the YouTube channel DaVisco
      Background Lab.
    </p>
    <a
      href="https://www.youtube.com/@DaViscoBackgroundLab"
      target="_blank"
      rel="noreferrer"
      class="mt-5 inline-block rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white"
    >
      Open DaVisco Background Lab
    </a>
  </section>

  <section class="mt-12 grid gap-6 md:grid-cols-3">
    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6">
      <p class="text-xs uppercase tracking-[0.25em] text-cyan-400">
        Lab
      </p>
      <h2 class="mt-3 text-2xl font-semibold text-white">Music Lab</h2>
      <p class="mt-3 text-zinc-400">
        Suno workflows, experiments, and production process notes.
      </p>
      <a
        href="/music/davisco-music-lab"
        class="mt-5 inline-block rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white"
      >
        Open lab
      </a>
    </article>

    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6">
      <p class="text-xs uppercase tracking-[0.25em] text-cyan-400">
        Creator Packs
      </p>
      <h2 class="mt-3 text-2xl font-semibold text-white">Background Music Packs</h2>
      <p class="mt-3 text-zinc-400">
        Curated background packs for video creators, available for purchase.
      </p>
      <a
        href="/downloads#music-packs"
        class="mt-5 inline-block rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white"
      >
        View packs
      </a>
    </article>

    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6">
      <p class="text-xs uppercase tracking-[0.25em] text-cyan-400">
        Releases
      </p>
      <h2 class="mt-3 text-2xl font-semibold text-white">Mixes and Tracks</h2>
      <p class="mt-3 text-zinc-400">
        DaVisco Music releases organized into long mixes and standalone tracks.
      </p>
      <a
        href="https://www.youtube.com/@DaViscoBackgroundLab"
        target="_blank"
        rel="noreferrer"
        class="mt-5 inline-block rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white"
      >
        Open channel
      </a>
    </article>
  </section>

  <section class="mt-12 grid gap-6 md:grid-cols-2">
    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6">
      <h3 class="text-2xl font-semibold text-white">Mixes</h3>
      <ul class="mt-4 space-y-4">
        {mixes.map((item) => (
          <li class="rounded-xl border border-zinc-800 p-4">
            <p class="text-sm text-zinc-500">{item.data.status}</p>
            <p class="mt-1 text-lg font-semibold text-white">{item.data.title}</p>
            <p class="mt-2 text-zinc-400">{item.data.description}</p>
            <a
              href={item.data.youtubeUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-3 inline-block text-sm font-semibold text-cyan-300 hover:text-cyan-200"
            >
              Open on YouTube
            </a>
          </li>
        ))}
      </ul>
    </article>

    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6">
      <h3 class="text-2xl font-semibold text-white">Tracks</h3>
      <ul class="mt-4 space-y-4">
        {tracks.map((item) => (
          <li class="rounded-xl border border-zinc-800 p-4">
            <p class="text-sm text-zinc-500">{item.data.status}</p>
            <p class="mt-1 text-lg font-semibold text-white">{item.data.title}</p>
            <p class="mt-2 text-zinc-400">{item.data.description}</p>
            <a
              href={item.data.youtubeUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-3 inline-block text-sm font-semibold text-cyan-300 hover:text-cyan-200"
            >
              Open on YouTube
            </a>
          </li>
        ))}
      </ul>
    </article>
  </section>
</BaseLayout>
