---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const releases = (await getCollection("musicReleases")).sort(
  (a, b) =>
    (b.data.releaseDate?.getTime() ?? 0) -
    (a.data.releaseDate?.getTime() ?? 0)
);
const mixes = releases.filter((item) => item.data.type === "mix");
const tracks = releases.filter((item) => item.data.type === "track");
---

<BaseLayout
  title="Music | DaVisco Entertainment"
  description="DaVisco Music hub with AI music lab workflows, creator packs, mixes, and standalone tracks."
  theme="music"
>
  <section>
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.3em] text-cyan-400">Music</p>

    <h1 class="text-4xl font-bold text-white md:text-6xl">DaVisco Music</h1>

    <p class="mt-5 max-w-3xl text-lg leading-8 text-zinc-400">
      Two main music directions: creator-first background music and artist
      releases under DaVisco Music.
    </p>
  </section>

  <section class="mt-12 grid gap-6">
    <article class="rounded-3xl border border-cyan-400/25 bg-[radial-gradient(140%_120%_at_0%_0%,rgba(56,189,248,0.18),transparent_58%),linear-gradient(180deg,rgba(16,20,34,0.92),rgba(12,15,28,0.9))] p-7 md:p-8">
      <div class="grid items-start gap-6 md:grid-cols-[180px_1fr]">
        <div class="mx-auto flex h-40 w-40 items-center justify-center rounded-full border border-cyan-300/35 bg-zinc-950/80 p-4 shadow-[0_0_0_8px_rgba(56,189,248,0.08),0_18px_40px_rgba(2,8,23,0.55)] md:mx-0">
          <img
            src="/images/content/music/davisco_background_lab_logo_dark.png"
            alt="DaVisco Background Lab logo"
            class="h-full w-full rounded-full object-cover"
            loading="lazy"
          />
        </div>
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-cyan-300">Section 01</p>
          <h2 class="mt-3 text-4xl font-bold text-white">DaVisco Background Lab</h2>
          <p class="mt-4 max-w-3xl text-zinc-300">
            Background music system for creators: categorized mood packs, workflow
            experiments and long-form YouTube previews.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="https://www.youtube.com/@DaViscoBackgroundLab"
              target="_blank"
              rel="noreferrer"
              class="rounded-xl border border-cyan-300/35 bg-cyan-400/10 px-4 py-2 text-sm font-semibold text-cyan-100 hover:border-cyan-200 hover:bg-cyan-400/20"
            >
              Open YouTube
            </a>
            <a
              href="/downloads#music-packs"
              class="rounded-xl border border-zinc-600 px-4 py-2 text-sm font-semibold text-zinc-200 hover:border-zinc-400 hover:text-white"
            >
              Music packs
            </a>
            <a
              href="/music/davisco-music-lab"
              class="rounded-xl border border-zinc-600 px-4 py-2 text-sm font-semibold text-zinc-200 hover:border-zinc-400 hover:text-white"
            >
              Open lab
            </a>
          </div>
        </div>
      </div>
    </article>

    <article class="rounded-3xl border border-violet-400/25 bg-[radial-gradient(140%_120%_at_0%_0%,rgba(168,85,247,0.2),transparent_58%),linear-gradient(180deg,rgba(19,16,36,0.94),rgba(14,12,30,0.9))] p-7 md:p-8">
      <div class="grid items-start gap-6 md:grid-cols-[180px_1fr]">
        <div class="mx-auto flex h-40 w-40 items-center justify-center rounded-full border border-violet-300/35 bg-black/80 p-4 shadow-[0_0_0_8px_rgba(168,85,247,0.10),0_18px_40px_rgba(2,8,23,0.55)] md:mx-0">
          <img
            src="/images/content/music/logo_black_bg.png"
            alt="DaVisco Music logo"
            class="h-full w-full rounded-full object-cover"
            loading="lazy"
          />
        </div>
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-violet-300">Section 02</p>
          <h2 class="mt-3 text-4xl font-bold text-white">DaVisco Music</h2>
          <p class="mt-4 max-w-3xl text-zinc-300">
            Artist-facing music project with original direction, standalone tracks,
            and curated mixes published as releases.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="https://www.youtube.com/channel/UCkpctdnRdRYcBQIsbcVsAUA"
              target="_blank"
              rel="noreferrer"
              class="rounded-xl border border-violet-300/35 bg-violet-400/10 px-4 py-2 text-sm font-semibold text-violet-100 hover:border-violet-200 hover:bg-violet-400/20"
            >
              Open channel
            </a>
          </div>
        </div>
      </div>
    </article>
  </section>

  <section class="mt-12 grid gap-6 md:grid-cols-2">
    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6">
      <h3 class="text-2xl font-semibold text-white">Mixes</h3>
      <ul class="mt-4 space-y-4">
        {mixes.map((item) => (
          <li class="rounded-xl border border-zinc-800 p-4">
            <p class="text-sm text-zinc-500">{item.data.status}</p>
            <p class="mt-1 text-lg font-semibold text-white">{item.data.title}</p>
            <p class="mt-2 text-zinc-400">{item.data.description}</p>
            <a
              href={item.data.youtubeUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-3 inline-block text-sm font-semibold text-cyan-300 hover:text-cyan-200"
            >
              Open on YouTube
            </a>
          </li>
        ))}
      </ul>
    </article>

    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6">
      <h3 class="text-2xl font-semibold text-white">Tracks</h3>
      <ul class="mt-4 space-y-4">
        {tracks.map((item) => (
          <li class="rounded-xl border border-zinc-800 p-4">
            <p class="text-sm text-zinc-500">{item.data.status}</p>
            <p class="mt-1 text-lg font-semibold text-white">{item.data.title}</p>
            <p class="mt-2 text-zinc-400">{item.data.description}</p>
            <a
              href={item.data.youtubeUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-3 inline-block text-sm font-semibold text-cyan-300 hover:text-cyan-200"
            >
              Open on YouTube
            </a>
          </li>
        ))}
      </ul>
    </article>
  </section>
</BaseLayout>
