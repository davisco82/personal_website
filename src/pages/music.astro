---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const [releases, downloads] = await Promise.all([
  getCollection("musicReleases"),
  getCollection("downloads"),
]);

const sortedReleases = releases.sort(
  (a, b) =>
    (b.data.releaseDate?.getTime() ?? 0) -
    (a.data.releaseDate?.getTime() ?? 0)
);
const mixes = sortedReleases.filter((item) => item.data.type === "mix");
const tracks = sortedReleases.filter((item) => item.data.type === "track");
const featuredPacks = downloads
  .filter((item) => item.data.kind === "music-pack")
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const getPackLabel = (item, index) => {
  const text = `${item.data.title} ${item.data.description}`.toLowerCase();

  if (text.includes("action") || text.includes("motion") || text.includes("tension")) {
    return "Action";
  }

  if (text.includes("cinematic") || text.includes("emotional") || text.includes("light")) {
    return "Cinematic";
  }

  if (text.includes("ambient") || text.includes("calm") || text.includes("atmospheric")) {
    return "Ambient";
  }

  if (text.includes("corporate") || text.includes("tech") || text.includes("minimal")) {
    return "Corporate";
  }

  if (text.includes("electronic") || text.includes("modern") || text.includes("percussion")) {
    return "Electronic";
  }

  return ["Action", "Cinematic", "Ambient", "Corporate"][index % 4];
};
---
<BaseLayout
  title="Music | DaVisco Entertainment"
  description="DaVisco Music with background packs and original artist projects."
  theme="music"
>
  <section class="mt-6">
    <div class="music-submenu" aria-label="Music sections">
      <button
        type="button"
        class="music-submenu-button"
        data-music-tab="background"
        data-active="true"
        aria-pressed="true"
      >
        <span class="music-submenu-button__title">DaVisco Background Music</span>
      </button>

      <button
        type="button"
        class="music-submenu-button"
        data-music-tab="project"
        data-active="false"
        aria-pressed="false"
      >
        <span class="music-submenu-button__title">Music Projects</span>
      </button>
    </div>

    <article class="music-panel mt-4" data-music-panel="background" data-active="true">
      <div class="music-panel__content" data-music-content="background">
        <div class="music-background-hero">
          <div class="music-background-hero__logo">
            <img
              src="/images/logo_transparent_white.webp"
              alt="DaVisco Music logo"
              class="block h-auto w-full object-contain"
              loading="eager"
            />
          </div>

          <div class="music-background-hero__copy">
            <h2 class="text-2xl font-bold text-white md:text-4xl">
              Premium background music for creators and storytellers.
            </h2>
            <p class="mt-4 max-w-3xl text-base leading-8 text-zinc-300 md:text-lg">
              Curated music packs for videos, podcasts, games, and more. High-quality,
              royalty-free, and crafted to set the right mood without getting in the way.
            </p>

            <div class="mt-6 flex flex-wrap gap-3">
              <a
                href="https://www.youtube.com/@DaViscoBackgroundLab"
                target="_blank"
                rel="noreferrer"
                class="music-action-button music-action-button--violet"
              >
                YouTube Channel
              </a>
              <a href="/downloads#music-packs" class="music-action-button music-action-button--neutral">
                Browse All Packs
              </a>
            </div>

            <div class="music-stat-bubbles mt-8">
              <div class="music-stat-bubble">
                <span class="music-stat-bubble__label">Packs</span>
                <span class="music-stat-bubble__value" data-count-up="13">0</span>
              </div>
              <div class="music-stat-bubble">
                <span class="music-stat-bubble__label">YouTube previews</span>
                <span class="music-stat-bubble__value" data-count-up="26">0</span>
              </div>
              <div class="music-stat-bubble">
                <span class="music-stat-bubble__label">Total tracks</span>
                <span class="music-stat-bubble__value" data-count-up="144">0</span>
              </div>
            </div>
          </div>
        </div>

        <section class="music-section-block">
          <div class="music-section-head">
            <div>
              <h3 class="text-2xl font-semibold text-white">Featured Music Packs</h3>
              <p class="mt-2 text-sm text-zinc-400">A selection of the current background catalog.</p>
            </div>
            <a href="/downloads" class="music-section-link">View all packs</a>
          </div>

          <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
            {featuredPacks.map((pack, index) => (
              <article class={`music-featured-card music-featured-card--${index % 4}`}>
                <div class="music-featured-cover">
                  <span class="music-featured-cover__badge">{getPackLabel(pack, index)}</span>
                  <span class="music-featured-cover__meta">{pack.data.format ?? "WAV / MP3"}</span>
                </div>

                <div class="music-featured-body">
                  <h4 class="text-xl font-semibold text-white">{pack.data.title}</h4>
                  <p class="mt-3 text-sm leading-6 text-zinc-400">{pack.data.description}</p>

                  <div class="mt-5 flex items-center justify-between gap-3">
                    <a
                      href={pack.data.href}
                      target={pack.data.external ? "_blank" : undefined}
                      rel={pack.data.external ? "noreferrer" : undefined}
                      class="music-mini-button music-mini-button--violet"
                    >
                      Preview
                    </a>
                    <span class="text-xs uppercase tracking-[0.22em] text-zinc-500">
                      {pack.data.ctaLabel}
                    </span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="music-section-block">
          <div class="music-section-head">
            <div>
              <h3 class="text-2xl font-semibold text-white">Latest Previews</h3>
              <p class="mt-2 text-sm text-zinc-400">Listen on YouTube for the latest previews.</p>
            </div>
            <a
              href="https://www.youtube.com/@DaViscoBackgroundLab"
              target="_blank"
              rel="noreferrer"
              class="music-section-link"
            >
              Go to YouTube Channel
            </a>
          </div>

          <div class="mt-6 grid gap-5 lg:grid-cols-2">
            {[
              {
                title: "DaVisco Background Music Preview 01",
                description: "A first preview from the background music side.",
                url: "https://www.youtube.com/embed/Ask_bPyYP8s",
              },
              {
                title: "DaVisco Background Music Preview 02",
                description: "A second preview with a different mood and feel.",
                url: "https://www.youtube.com/embed/gdHMt3Z6Xtg",
              },
            ].map((item, index) => (
              <article class="music-preview-card">
                <div class={`music-preview-card__embed music-preview-card__embed--${index % 2}`}>
                  <iframe
                    src={item.url}
                    title={item.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  />
                </div>

                <div class="mt-4">
                  <p class="text-xs uppercase tracking-[0.22em] text-zinc-500">Preview</p>
                  <h4 class="mt-1 text-xl font-semibold text-white">{item.title}</h4>
                  <p class="mt-2 text-sm leading-6 text-zinc-400">{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      </div>

      <div class="music-panel__content hidden" data-music-content="project" aria-hidden="true">
        <div class="grid gap-8 lg:grid-cols-[220px_minmax(0,1fr)] lg:items-start">
          <div class="music-logo-ring music-logo-ring-violet mx-auto lg:mx-0">
            <img
              src="/images/content/music/logo_black_bg.png"
              alt="DaVisco Music logo"
              class="h-full w-full rounded-full object-cover"
              loading="lazy"
            />
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-3">
              <p class="text-xs uppercase tracking-[0.28em] text-violet-300">Music Projects</p>
              <span class="rounded-full border border-violet-300/20 bg-violet-400/10 px-3 py-1 text-xs font-semibold text-violet-100">
                Placeholder content
              </span>
            </div>

            <h2 class="mt-4 text-3xl font-bold text-white md:text-5xl">DaVisco Music Projects</h2>

            <p class="mt-4 max-w-3xl text-zinc-300 leading-8">
              This section will hold original tracks, lyrics, mixes, release notes, and any
              project-specific content you want to add next. For now it stays clean and ready
              for your copy.
            </p>

            <div class="mt-6 flex flex-wrap gap-3">
              <span class="music-pill music-pill-violet">Tracks</span>
              <span class="music-pill music-pill-neutral">Lyrics</span>
              <span class="music-pill music-pill-neutral">Mixes</span>
            </div>
          </div>
        </div>

        <div class="mt-10 music-note">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-zinc-400">Coming next</p>
          <h3 class="mt-3 text-2xl font-semibold text-white">Project content goes here</h3>
          <p class="mt-3 max-w-3xl text-zinc-300 leading-8">
            You can add your own structure here later: lyrics, concept notes, release links,
            embedded media, or a timeline of upcoming originals. The layout is already ready
            for that content without needing another redesign.
          </p>
        </div>
      </div>
    </article>
  </section>
  <script is:inline>
    const tabs = Array.from(document.querySelectorAll("[data-music-tab]"));
    const panel = document.querySelector("[data-music-panel]");
    const contents = Array.from(document.querySelectorAll("[data-music-content]"));
    const countUpTargets = Array.from(document.querySelectorAll("[data-count-up]"));

    const animateCount = (node) => {
      const target = Number(node.dataset.countUp ?? "0");
      const duration = 2200;
      const start = performance.now();

      const tick = (now) => {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = Math.floor(target * eased);

        node.textContent = String(value);

        if (progress < 1) {
          window.requestAnimationFrame(tick);
        } else {
          node.textContent = String(target);
        }
      };

      window.requestAnimationFrame(tick);
    };

    const setActive = (activeName) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.musicTab === activeName;
        tab.setAttribute("aria-pressed", String(isActive));
        tab.dataset.active = String(isActive);
      });

      contents.forEach((content) => {
        const isActive = content.dataset.musicContent === activeName;
        content.hidden = !isActive;
        content.setAttribute("aria-hidden", String(!isActive));
        content.classList.toggle("music-panel__content--animate", isActive);
      });

      if (panel) {
        panel.dataset.active = activeName;
        panel.classList.add("music-panel--animate");
        window.setTimeout(() => panel.classList.remove("music-panel--animate"), 340);
      }
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => setActive(tab.dataset.musicTab));
    });

    countUpTargets.forEach((node) => animateCount(node));
    setActive("background");
  </script>
</BaseLayout>
