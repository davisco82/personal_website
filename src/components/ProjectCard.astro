---
const {
  title,
  slug,
  description,
  status = "Experimental",
  stack = [],
  links = [],
  tone = "cyan",
} = Astro.props;
---

<article class={`project-card project-card--${tone}`}>
  <div class="flex items-start justify-between gap-4">
    <h2 class="text-2xl font-bold text-white">
      <a href={`/projects/${slug}`} class="project-card__title-link">
        {title}
      </a>
    </h2>

    <span class="project-card__status">
      {status}
    </span>
  </div>

  <p class="mt-4 leading-7 text-zinc-400">
    {description}
  </p>

  <div class="mt-5 flex flex-wrap gap-2">
    {stack.map((item) => (
      <span class="project-card__stack-item">
        {item}
      </span>
    ))}
  </div>

  <div class="project-card__links mt-6 flex flex-wrap gap-4 text-sm font-medium">
    {links.map((link) => (
      <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>
        {link.label}
      </a>
    ))}
  </div>
</article>
