---
const {
  title,
  slug,
  description,
  status = "Experimental",
  stack = [],
  links = [],
  tone = "cyan",
  image,
  imageAlt,
  layout = "compact",
} = Astro.props;

const primaryLink = links[0];
const secondaryLink = links[1];
---

<article class={`project-card project-card--${tone} project-card--${layout}`}>
  {layout === "showcase" ? (
    <>
      <div class="project-card__hero">
        <div class="project-card__hero-overlay"></div>
        <div class="project-card__hero-status">{status}</div>
        {image ? (
          <img
            src={image}
            alt={imageAlt ?? `${title} logo`}
            class="project-card__hero-image"
            loading="lazy"
          />
        ) : (
          <div class="project-card__hero-fallback">
            <span>{title}</span>
          </div>
        )}
        {primaryLink && (
          <a
            href={primaryLink.href}
            target={primaryLink.external ? "_blank" : undefined}
            rel={primaryLink.external ? "noreferrer" : undefined}
            class="project-card__hero-preview"
          >
            <span class="project-card__hero-preview-icon">▶</span>
            <span>See preview</span>
          </a>
        )}
      </div>

      <div class="project-card__body">
        <div class="flex items-start justify-between gap-4">
          <h2 class="text-2xl font-bold text-white md:text-3xl">
            <a href={`/projects/${slug}`} class="project-card__title-link">
              {title}
            </a>
          </h2>

          <span class="project-card__status">
            {status}
          </span>
        </div>

        <p class="mt-4 leading-7 text-zinc-400">
          {description}
        </p>

        <div class="mt-5 flex flex-wrap gap-2">
          {stack.map((item) => (
            <span class="project-card__stack-item">
              {item}
            </span>
          ))}
        </div>

        <div class="project-card__links mt-6 flex flex-wrap gap-4 text-sm font-medium">
          {primaryLink && (
            <a
              href={primaryLink.href}
              target={primaryLink.external ? "_blank" : undefined}
              rel={primaryLink.external ? "noreferrer" : undefined}
              class="project-card__button project-card__button--primary"
            >
              {primaryLink.label}
            </a>
          )}
          {secondaryLink && (
            <a
              href={secondaryLink.href}
              target={secondaryLink.external ? "_blank" : undefined}
              rel={secondaryLink.external ? "noreferrer" : undefined}
              class="project-card__button project-card__button--secondary"
            >
              {secondaryLink.label}
            </a>
          )}
        </div>
      </div>
    </>
  ) : (
    <>
      {image && (
        <div class="project-card__media">
          <img
            src={image}
            alt={imageAlt ?? `${title} logo`}
            class="project-card__media-image"
            loading="lazy"
          />
        </div>
      )}

      <div class={image ? "mt-4 flex items-start justify-between gap-4" : "flex items-start justify-between gap-4"}>
        <h2 class="text-2xl font-bold text-white">
          <a href={`/projects/${slug}`} class="project-card__title-link">
            {title}
          </a>
        </h2>

        <span class="project-card__status">
          {status}
        </span>
      </div>

      <p class="mt-4 leading-7 text-zinc-400">
        {description}
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        {stack.map((item) => (
          <span class="project-card__stack-item">
            {item}
          </span>
        ))}
      </div>

      <div class="project-card__links mt-6 flex flex-wrap gap-4 text-sm font-medium">
        {links.map((link) => (
          <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>
            {link.label}
          </a>
        ))}
      </div>
    </>
  )}
</article>
