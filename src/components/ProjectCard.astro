---
const {
  title,
  slug,
  description,
  status = "Experimental",
  stack = [],
  links = [],
} = Astro.props;
---

<article class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6 shadow-xl">
  <div class="flex items-start justify-between gap-4">
    <h2 class="text-2xl font-bold text-white">
        <a href={`/projects/${slug}`}>
            {title}
        </a>
    </h2>

    <span class="rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-medium text-cyan-300">
      {status}
    </span>
  </div>

  <p class="mt-4 leading-7 text-zinc-400">
    {description}
  </p>

  <div class="mt-5 flex flex-wrap gap-2">
    {stack.map((item) => (
      <span class="rounded-full bg-zinc-800 px-3 py-1 text-xs text-zinc-300">
        {item}
      </span>
    ))}
  </div>

  <div class="mt-6 flex flex-wrap gap-4 text-sm font-medium">
    {links.map((link) => (
      <a href={link.href} target={link.external ? "_blank" : undefined}>
        {link.label}
      </a>
    ))}
  </div>
</article>