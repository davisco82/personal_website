---
const { title, description, items = [] } = Astro.props;
---

<article class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6 shadow-xl">
  <h2 class="text-xl font-bold text-white">{title}</h2>

  <p class="mt-3 leading-7 text-zinc-400">
    {description}
  </p>

  <ul class="mt-5 space-y-2 text-sm text-zinc-300">
    {items.map((item) => (
      <li>→ {item}</li>
    ))}
  </ul>
</article>